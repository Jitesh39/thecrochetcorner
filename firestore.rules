rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public read
      allow write: if isAdmin(); // Admin-only editing
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId; // User-only profile editing
      allow read: if isAdmin(); // Admin can view all users
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null; // Any logged-in user can place an order
      allow update: if isAdmin(); // Only admin can update order status
    }
  }
}
